RewriteEngine On

# В каталоге нет index.php, а DirectoryIndex сайта (views/page.php) сюда не
# подходит: точка входа — собранная страница.
DirectoryIndex index.html

# Правила сайта до сюда не доходят, поэтому листинг каталогов выключается явно.
Options -Indexes

# Чанк приложения лежит в server/private/ui, вне досягаемости по сети, и
# отдаётся только вошедшему. URL при этом остаётся прежним: внутри чанка есть
# относительные импорты соседних файлов (docs/auth-gate-plan.md).
RewriteRule ^assets/gated-([A-Za-z0-9_-]+)\.js$ server/api/ui/chunk.php [END,QSA]

# Настройки (база, почта, разрешённые источники) здесь не задаются: они в
# server/config.local.php. Так пароль базы не лежит в файле маршрутизации, а
# выкладка не зависит от того, как PHP на сервере читает окружение Apache
# (docs/deploy-otop-rf.md, раздел 8).
